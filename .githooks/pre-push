#!/usr/bin/env bash
# pre-push — the whole gate, before anything leaves the machine.
#
# CI runs the parts that need no toolchain beyond Python and PlatformIO. The board
# tools need pcbnew, which lives inside a KiCad install: roughly a gigabyte to fetch
# on a runner, for a directory that only changes when someone is working on a board.
# The machine where boards are edited already has it. So the gate runs here, where
# the toolchain is, and CI stays the backstop for everything else.
#
# What this can and cannot promise: `git push --no-verify` skips it, and a clone that
# never ran tools/install_hooks.sh has no hook at all. "The repo is always green"
# means "green on any machine that installed this and did not bypass it" — which is
# the honest version, and enough for a repo with one maintainer.
#
# Every step runs even after one fails, so a push tells you everything that is wrong
# rather than the first thing.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

FAILED=()
SKIPPED=()

say() { printf '[pre-push] %s\n' "$*" >&2; }

step() {
    local name="$1"; shift
    if "$@" >/tmp/pre-push-out 2>&1; then
        say "ok      $name"
    else
        say "FAILED  $name"
        sed 's/^/          /' /tmp/pre-push-out >&2
        FAILED+=("$name")
    fi
}

# --- PlatformIO -------------------------------------------------------------
# The same resolution order tools/setup_build_env.sh uses: PATH first, then the
# standard penv install locations.
find_pio() {
    if command -v pio >/dev/null 2>&1; then command -v pio; return 0; fi
    local c
    for c in "$HOME/.platformio/penv/bin/pio" \
             "${USERPROFILE:-}/.platformio/penv/Scripts/pio.exe" \
             "$HOME/.platformio/penv/Scripts/pio.exe"; do
        [ -n "$c" ] && [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

PIO="$(find_pio || true)"
if [ -n "${PIO:-}" ]; then
    step "native tests" "$PIO" test -e native
    # The other side of the feature switches: the library built for a product that wants
    # neither optional domain. Cheap -- one suite -- and it is the only thing that compiles
    # the absent branch of every #if PEDAL_CORE_HAS_*.
    step "native tests (minimal)" "$PIO" test -e native_minimal
else
    say "SKIPPED native tests — no PlatformIO found (run tools/setup_build_env.sh)"
    SKIPPED+=("native tests")
fi

# --- Python ------------------------------------------------------------------
PY=python
command -v python >/dev/null 2>&1 || PY=python3

# A KiCad interpreter that can actually import pcbnew.
#
# Asking kicad_env for KICAD_PY is not enough on its own: on Linux its candidate
# list includes /usr/bin/python3, which exists on almost any machine whether or not
# KiCad is installed. The only honest question is whether that interpreter can
# import the module, so that is the question asked.
KICAD_PY="$("$PY" - <<'PYEOF' 2>/dev/null || true
import sys
sys.path.insert(0, "tools/kicad")
try:
    import kicad_env
    print(kicad_env.resolve("KICAD_PY", required=False) or "")
except Exception:
    print("")
PYEOF
)"

HAVE_PCBNEW=0
if [ -n "${KICAD_PY:-}" ] && [ -x "$KICAD_PY" ] && "$KICAD_PY" -c "import pcbnew" >/dev/null 2>&1; then
    HAVE_PCBNEW=1
fi

# Every tools test, discovered rather than listed, so a new one is picked up by
# existing it. A test that imports pcbnew runs under the KiCad interpreter; the rest
# run under the ambient one.
for t in tools/test_*.py tools/kicad/test_*.py; do
    [ -e "$t" ] || continue
    if grep -q '^import pcbnew' "$t"; then
        if [ "$HAVE_PCBNEW" = "1" ]; then
            step "$t" "$KICAD_PY" "$t"
        else
            say "SKIPPED $t — no interpreter here can import pcbnew."
            say "        Install KiCad, or set KICAD_PY, or add it to kicad/tools/local.env."
            SKIPPED+=("$t")
        fi
    else
        step "$t" "$PY" "$t"
    fi
done

step "doc links" "$PY" tools/check_doc_links.py

# The library compiles clean, so a consumer can turn -Werror on. Its own ARM leg is skipped
# where no toolchain is installed, the same way the board tests are.
step "warnings" bash tools/check_warnings.sh

# --- verdict -----------------------------------------------------------------
rm -f /tmp/pre-push-out

if [ "${#SKIPPED[@]}" -gt 0 ]; then
    say "${#SKIPPED[@]} step(s) skipped: ${SKIPPED[*]}"
fi

if [ "${#FAILED[@]}" -gt 0 ]; then
    say ""
    say "push refused: ${#FAILED[@]} step(s) failed — ${FAILED[*]}"
    say "To push anyway: git push --no-verify"
    exit 1
fi

say "gate green — pushing."
exit 0
